# GitHub fine-grained token, read-only public data (ACTIVITY heatmap)
GITHUB_TOKEN=
# Shared secret the Pi / home server send as "Authorization: Bearer <token>"
HEARTBEAT_TOKEN=
# Upstash (set by the Vercel integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.prathlab.com
# Optional: overrides the contact email in content/site.ts
NEXT_PUBLIC_CONTACT_EMAIL=
# Admin panel (/admin, or `sudo su` in the command prompt). Password you type; secret signs the session cookie.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SECRET=
# Vercel Blob (set by the Vercel Blob integration): songs / reboot sounds uploaded from /admin
BLOB_READ_WRITE_TOKEN=
# Spotify now playing (scripts/spotify-auth.mjs gets the refresh token). Leave empty to keep it off.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
