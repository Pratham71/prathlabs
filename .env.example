# GitHub fine-grained token, read-only public data (ACTIVITY heatmap)
GITHUB_TOKEN=
# Shared secret the Pi / home server send as "Authorization: Bearer <token>"
HEARTBEAT_TOKEN=
# Upstash (set by the Vercel integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.prathlab.com
# Optional: shows mail(1) in SEE ALSO when set
NEXT_PUBLIC_CONTACT_EMAIL=
