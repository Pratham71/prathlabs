# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# audio files: licensed music and sounds never go in this public repo (upload via /admin instead)
/public/music/**/*.mp3
/public/music/**/*.m4a
/public/music/**/*.wav
/public/music/**/*.ogg
/public/sfx/**/*.mp3
/public/sfx/**/*.m4a
/public/sfx/**/*.wav
/public/sfx/**/*.ogg

# reference images for drawing sprites (game renders, not ours to publish)
/images/
